<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh Mục Sản Phẩm - AMADO</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: #ff6b6b;
            --secondary-color: #4ecdc4;
            --accent-color: #45b7d1;
            --dark-color: #2c3e50;
            --light-color: #f8f9fa;
            --gray-color: #6c757d;
            --success-color: #2ecc71;
            --warning-color: #f39c12;
            --danger-color: #e74c3c;
            --border-radius: 16px;
            --box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: var(--dark-color);
            line-height: 1.7;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }
        
        /* Header Styles (giữ nguyên) */
        .main-header {
            background: rgba(255, 255, 255, 0.98);
            padding: 18px 0;
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(12px);
            transition: var(--transition);
            border-bottom: 1px solid rgba(255, 107, 107, 0.1);
        }
        
        .logo {
            font-size: 32px;
            font-weight: 800;
            color: var(--primary-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            letter-spacing: -0.5px;
        }
        
        .logo i {
            margin-right: 12px;
            font-size: 36px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        /* Categories Section */
        .categories-section {
            padding: 100px 0 80px;
            background: linear-gradient(to bottom, #f9f9f9 0%, #ffffff 100%);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 60px;
            position: relative;
        }
        
        .section-title h1 {
            font-size: 3rem;
            font-weight: 800;
            color: var(--dark-color);
            display: inline-block;
            position: relative;
            letter-spacing: -0.5px;
        }
        
        .section-title h1:after {
            content: '';
            display: block;
            width: 100px;
            height: 6px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            margin: 20px auto;
            border-radius: 3px;
        }
        
        .section-subtitle {
            font-size: 1.2rem;
            color: var(--gray-color);
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }
        
        .category-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 40px 30px;
            text-align: center;
            transition: var(--transition);
            box-shadow: var(--box-shadow);
            border: 1px solid rgba(255, 255, 255, 0.8);
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        
        .category-card:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            opacity: 0;
            transition: var(--transition);
            z-index: 1;
        }
        
        .category-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        }
        
        .category-card:hover:before {
            opacity: 0.03;
        }
        
        .category-icon {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            color: white;
            font-size: 48px;
            transition: var(--transition);
            position: relative;
            z-index: 2;
            box-shadow: 0 10px 25px rgba(255, 107, 107, 0.3);
        }
        
        .category-card:hover .category-icon {
            transform: scale(1.15) rotate(8deg);
            box-shadow: 0 15px 30px rgba(255, 107, 107, 0.4);
        }
        
        .category-name {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--dark-color);
            position: relative;
            z-index: 2;
            transition: var(--transition);
        }
        
        .category-card:hover .category-name {
            color: var(--primary-color);
        }
        
        .category-description {
            color: var(--gray-color);
            font-size: 1rem;
            position: relative;
            z-index: 2;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        .category-stats {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            position: relative;
            z-index: 2;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-color);
            display: block;
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: var(--gray-color);
        }
        
        .explore-btn {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 600;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            text-decoration: none;
            display: inline-block;
            margin-top: 16px;
        }
        
        .explore-btn:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0%;
            height: 100%;
            background: var(--primary-color);
            transition: var(--transition);
            z-index: -1;
        }
        
        .explore-btn:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(255, 107, 107, 0.3);
        }
        
        .explore-btn:hover:before {
            width: 100%;
        }
        
        /* Featured Products in Category */
        .featured-products {
            margin-top: 80px;
        }
        
        .featured-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 40px;
            text-align: center;
            color: var(--dark-color);
        }
        
        .products-slider {
            position: relative;
        }
        
        .product-slide {
            background: white;
            border-radius: var(--border-radius);
            padding: 24px;
            transition: var(--transition);
            box-shadow: var(--box-shadow);
            text-align: center;
        }
        
        .product-slide:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }
        
        .product-slide-image {
            width: 100%;
            height: 200px;
            object-fit: contain;
            margin-bottom: 16px;
        }
        
        .product-slide-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--dark-color);
        }
        
        .product-slide-price {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 16px;
        }
        
        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 80px 20px;
        }
        
        .empty-icon {
            font-size: 4rem;
            color: var(--gray-color);
            margin-bottom: 24px;
        }
        
        .empty-title {
            font-size: 1.8rem;
            color: var(--dark-color);
            margin-bottom: 16px;
        }
        
        .empty-text {
            color: var(--gray-color);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
        
        /* Responsive */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }
        }
        
        @media (max-width: 768px) {
            .section-title h1 {
                font-size: 2.5rem;
            }
            
            .categories-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 20px;
            }
            
            .category-icon {
                width: 100px;
                height: 100px;
                font-size: 40px;
            }
            
            .category-name {
                font-size: 1.4rem;
            }
        }
        
        @media (max-width: 576px) {
            .categories-grid {
                grid-template-columns: 1fr;
            }
            
            .categories-section {
                padding: 80px 0 60px;
            }
            
            .section-title h1 {
                font-size: 2rem;
            }
        }
        
        /* Footer (giữ nguyên) */
        .main-footer {
            background: var(--dark-color);
            color: white;
            padding: 80px 0 30px;
            position: relative;
        }
        
        .footer-logo {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 24px;
            display: inline-block;
            color: white;
            text-decoration: none;
            letter-spacing: -0.5px;
        }
        
        .social-links {
            display: flex;
            gap: 16px;
        }
        
        .social-link {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: var(--transition);
            font-size: 1.1rem;
        }
        
        .copyright {
            text-align: center;
            padding-top: 40px;
            margin-top: 60px;
            border-top: 1px solid rgba(255,255,255,0.1);
            color: #b0b7c3;
        }
    </style>
</head>
<body>
    <!-- Header (giữ nguyên) -->
    <header class="main-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-2 col-md-3 col-6">
                    <a href="/" class="logo">
                        <i class="fas fa-gem"></i>
                        AMADO
                    </a>
                </div>
                <div class="col-lg-6 col-md-5 d-none d-md-block">
                    <form class="search-form" action="/search" method="GET">
                        <input type="text" class="search-input" name="search" placeholder="Tìm kiếm sản phẩm...">
                        <button type="submit" class="search-btn">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
                <div class="col-lg-4 col-md-4 col-6 text-end">
                    <div class="user-actions d-flex justify-content-end align-items-center">
                        <div class="nav-icons d-none d-lg-flex">
                            <a href="/wishlist" class="nav-icon">
                                <i class="fas fa-heart"></i>
                                <span class="nav-badge">3</span>
                            </a>
                            <a href="/cart" class="nav-icon">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="nav-badge">5</span>
                            </a>
                        </div>
                        
                        <% if (customer) { %>
                            <div class="user-dropdown ms-3">
                                <div class="user-info dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <% if (customer.avatar) { %>
                                        <img src="<%= customer.avatar %>" alt="Avatar" class="user-avatar">
                                    <% } else { %>
                                        <div class="user-avatar bg-primary d-flex align-items-center justify-content-center text-white fw-bold">
                                            <%= customer.fullNameCustomer.firstName.charAt(0) %><%= customer.fullNameCustomer.lastName.charAt(0) %>
                                        </div>
                                    <% } %>
                                    <span class="user-name d-none d-md-inline">
                                        <%= customer.fullNameCustomer.firstName %> <%= customer.fullNameCustomer.lastName %>
                                    </span>
                                    <i class="fas fa-chevron-down ms-1 text-muted"></i>
                                </div>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>Tài khoản</a></li>
                                    <li><a class="dropdown-item" href="/orders"><i class="fas fa-box me-2"></i>Đơn hàng</a></li>
                                    <li><a class="dropdown-item" href="/wishlist"><i class="fas fa-heart me-2"></i>Yêu thích</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        <% } else { %>
                            <div class="d-flex gap-2">
                                <a href="/login" class="btn btn-outline-primary">Đăng nhập</a>
                                <a href="/sign-up" class="btn btn-primary">Đăng ký</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Categories Section -->
    <section class="categories-section">
        <div class="container">
            <div class="section-title">
                <h1>Danh Mục Sản Phẩm</h1>
                <p class="section-subtitle">Khám phá tất cả các danh mục sản phẩm đa dạng của AMADO</p>
            </div>

            <% if (data && data.length > 0) { %>
                <div class="categories-grid">
                    <% data.forEach(category => { %>
                        <div class="category-card">
                            <div class="category-icon">
                                <% if (category.thumbnail) { %>
                                    <img src="<%= category.thumbnail %>" alt="<%= category.typeName %>" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                                <% } else { %>
                                    <i class="fas fa-box"></i>
                                <% } %>
                            </div>
                            <h3 class="category-name"><%= category.typeName %></h3>
                            <p class="category-description">
                                <%= category.description || 'Khám phá các sản phẩm chất lượng trong danh mục này' %>
                            </p>
                            
                            <div class="category-stats">
                                <div class="stat-item">
                                    <span class="stat-number"><%= Math.floor(Math.random() * 100) + 50 %></span>
                                    <span class="stat-label">Sản phẩm</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number"><%= Math.floor(Math.random() * 20) + 5 %></span>
                                    <span class="stat-label">Thương hiệu</span>
                                </div>
                            </div>
                            
                            <a href="/categories/<%= category._id %>" class="explore-btn">
                                <i class="fas fa-arrow-right me-2"></i>Khám phá ngay
                            </a>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="empty-categories">
                    <div class="empty-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h2 class="empty-title">Chưa có danh mục sản phẩm</h2>
                    <p class="empty-text">
                        Hiện tại chưa có danh mục sản phẩm nào được cập nhật. Vui lòng quay lại sau để khám phá các danh mục mới nhất.
                    </p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="/" class="btn btn-primary btn-lg">Quay về trang chủ</a>
                        <a href="/product" class="btn btn-outline-primary btn-lg">Xem tất cả sản phẩm</a>
                    </div>
                </div>
            <% } %>

            <!-- Featured Products Section -->
            <% if (data && data.length > 0) { %>
                <div class="featured-products">
                    <h2 class="featured-title">Sản Phẩm Nổi Bật</h2>
                    <div class="products-slider">
                        <div class="row">
                            <!-- Sample featured products - in real app, you would fetch actual featured products -->
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="product-slide">
                                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" 
                                         alt="Sản phẩm nổi bật" class="product-slide-image">
                                    <h4 class="product-slide-name">Tai nghe cao cấp</h4>
                                    <div class="product-slide-price">1.299.000₫</div>
                                    <a href="#" class="explore-btn">Xem chi tiết</a>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="product-slide">
                                    <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" 
                                         alt="Sản phẩm nổi bật" class="product-slide-image">
                                    <h4 class="product-slide-name">Máy ảnh DSLR</h4>
                                    <div class="product-slide-price">12.999.000₫</div>
                                    <a href="#" class="explore-btn">Xem chi tiết</a>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="product-slide">
                                    <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" 
                                         alt="Sản phẩm nổi bật" class="product-slide-image">
                                    <h4 class="product-slide-name">Đồng hồ thông minh</h4>
                                    <div class="product-slide-price">3.499.000₫</div>
                                    <a href="#" class="explore-btn">Xem chi tiết</a>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="product-slide">
                                    <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" 
                                         alt="Sản phẩm nổi bật" class="product-slide-image">
                                    <h4 class="product-slide-name">Giày thể thao</h4>
                                    <div class="product-slide-price">899.000₫</div>
                                    <a href="#" class="explore-btn">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Footer (giữ nguyên) -->
    <footer class="main-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <a href="/" class="footer-logo">
                        <i class="fas fa-gem me-2"></i>AMADO
                    </a>
                    <p class="footer-description">AMADO - Địa chỉ mua sắm trực tuyến đáng tin cậy với hàng ngàn sản phẩm chất lượng. Chúng tôi cam kết mang đến trải nghiệm mua sắm tốt nhất cho khách hàng.</p>
                    <div class="social-links">
                        <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h4 class="footer-title">Liên Kết</h4>
                    <ul class="footer-links">
                        <li><a href="/">Trang Chủ</a></li>
                        <li><a href="/product">Sản Phẩm</a></li>
                        <li><a href="/about">Về Chúng Tôi</a></li>
                        <li><a href="/support">Hỗ Trợ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4 class="footer-title">Chính Sách</h4>
                    <ul class="footer-links">
                        <li><a href="#">Chính Sách Bảo Mật</a></li>
                        <li><a href="#">Điều Khoản Sử Dụng</a></li>
                        <li><a href="#">Chính Sách Đổi Trả</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4 class="footer-title">Liên Hệ</h4>
                    <ul class="contact-info">
                        <li>
                            <i class="fas fa-map-marker-alt"></i>
                            <span>123 Đường ABC, Quận XYZ, TP. Hà Nội, Việt Nam</span>
                        </li>
                        <li>
                            <i class="fas fa-phone"></i>
                            <span>0123 456 789</span>
                        </li>
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>info@amado.com</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                <p>&copy; 2024 AMADO. Tất cả các quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects to category cards
            const categoryCards = document.querySelectorAll('.category-card');
            
            categoryCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-15px) scale(1.02)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });
            
            // Simple animation for stats counting (for demo purposes)
            const statNumbers = document.querySelectorAll('.stat-number');
            
            statNumbers.forEach(stat => {
                const target = parseInt(stat.textContent);
                let current = 0;
                const increment = target / 30;
                
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    stat.textContent = Math.floor(current);
                }, 50);
            });
        });
    </script>
</body>
</html>