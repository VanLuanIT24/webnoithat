    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
        <script>
            // Pass server-side variables to JavaScript
            const serverData = {
                message: '<%= typeof message !== "undefined" ? message : "" %>',
                selected: '<%= typeof selected !== "undefined" ? selected : "" %>',
                supplierFilter: '<%= typeof supplierFilter !== "undefined" ? supplierFilter : "" %>'
            };
            
            document.addEventListener('DOMContentLoaded', function() {
                // Hiển thị thông báo flash
                const message = serverData.message;
            if (message) {
                const type = message.includes("thành công") ? "success" : "danger";
                showNotification(message, type);
            }
            
            // Header scroll effect
            const header = document.querySelector('.main-header');
            window.addEventListener('scroll', function() {
                if (window.scrollY > 100) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });
            
            // Back to top button
            const backToTopButton = document.querySelector('.back-to-top');
            window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                    backToTopButton.classList.add('show');
                } else {
                    backToTopButton.classList.remove('show');
                }
            });
            
            backToTopButton.addEventListener('click', function(e) {
                e.preventDefault();
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
            
            // Mobile sidebar toggle
            const filterToggle = document.querySelector('.filter-toggle');
            const sidebar = document.querySelector('.sidebar');
            const sidebarOverlay = document.querySelector('.sidebar-overlay');
            const sidebarClose = document.querySelector('.sidebar-close');
            
            if (filterToggle && sidebar) {
                filterToggle.addEventListener('click', function() {
                    sidebar.classList.add('show');
                    sidebarOverlay.classList.add('show');
                    document.body.style.overflow = 'hidden';
                });
                
                sidebarClose.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                });
                
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                });
            }
            
            // View toggle (grid/list)
            const viewButtons = document.querySelectorAll('.view-btn');
            const productsView = document.getElementById('products-view');
            
            viewButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const viewType = this.getAttribute('data-view');
                    
                    // Update active button
                    viewButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Change view
                    if (viewType === 'list') {
                        productsView.classList.add('products-list');
                        productsView.classList.remove('products-grid');
                        localStorage.setItem('productView', 'list');
                    } else {
                        productsView.classList.add('products-grid');
                        productsView.classList.remove('products-list');
                        localStorage.setItem('productView', 'grid');
                    }
                });
            });
            
            // Khôi phục view preference
            const savedView = localStorage.getItem('productView') || 'grid';
            if (savedView === 'list') {
                document.querySelector('[data-view="list"]').click();
            }
            
            // Add to cart functionality
            const addToCartButtons = document.querySelectorAll('.btn-add-to-cart');
            addToCartButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (productId && !this.disabled) {
                        // Simulate adding to cart
                        const originalText = this.innerHTML;
                        this.innerHTML = '<span class="loading-spinner"></span>';
                        this.disabled = true;
                        
                        // Gửi request đến server
                        fetch('/cart/add', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                productId: productId,
                                quantity: 1
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showNotification('Sản phẩm đã được thêm vào giỏ hàng!', 'success');
                                this.innerHTML = '<i class="fas fa-check me-2"></i>Đã Thêm';
                                
                                // Update cart badge
                                const cartBadge = document.querySelector('.nav-badge');
                                if (cartBadge) {
                                    let currentCount = parseInt(cartBadge.textContent);
                                    cartBadge.textContent = currentCount + 1;
                                }
                            } else {
                                showNotification(data.message || 'Có lỗi xảy ra!', 'danger');
                                this.innerHTML = originalText;
                                this.disabled = false;
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showNotification('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'danger');
                            this.innerHTML = originalText;
                            this.disabled = false;
                        });
                        
                        // Reset button after 2 seconds nếu thành công
                        setTimeout(() => {
                            if (this.disabled) {
                                this.innerHTML = originalText;
                                this.disabled = false;
                            }
                        }, 2000);
                    }
                });
            });
            
            // Add to favorite functionality
            const favoriteButtons = document.querySelectorAll('.btn-favorite');
            favoriteButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (productId) {
                        if (this.classList.contains('active')) {
                            // Remove from favorites
                            removeFromFavorites(productId, this);
                        } else {
                            // Add to favorites
                            addToFavorites(productId, this);
                        }
                    }
                });
            });
            
            function addToFavorites(productId, button) {
                fetch('/wishlist/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId: productId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        button.classList.add('active');
                        button.innerHTML = '<i class="fas fa-heart"></i>';
                        showNotification('Đã thêm vào danh sách yêu thích!', 'success');
                        
                        // Update favorite badge
                        const favoriteBadge = document.querySelectorAll('.nav-badge')[0];
                        if (favoriteBadge) {
                            let currentCount = parseInt(favoriteBadge.textContent);
                            favoriteBadge.textContent = currentCount + 1;
                        }
                    } else {
                        showNotification(data.message || 'Có lỗi xảy ra!', 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Có lỗi xảy ra!', 'danger');
                });
            }
            
            function removeFromFavorites(productId, button) {
                fetch('/wishlist/remove', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId: productId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        button.classList.remove('active');
                        button.innerHTML = '<i class="fas fa-heart"></i>';
                        showNotification('Đã xóa khỏi danh sách yêu thích!', 'info');
                        
                        // Update favorite badge
                        const favoriteBadge = document.querySelectorAll('.nav-badge')[0];
                        if (favoriteBadge) {
                            let currentCount = parseInt(favoriteBadge.textContent);
                            if (currentCount > 0) {
                                favoriteBadge.textContent = currentCount - 1;
                            }
                        }
                    } else {
                        showNotification(data.message || 'Có lỗi xảy ra!', 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Có lỗi xảy ra!', 'danger');
                });
            }
            
            // Quick actions
            const quickActionButtons = document.querySelectorAll('.quick-action-btn');
            quickActionButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productCard = this.closest('.product-card');
                    const productId = productCard.getAttribute('data-product-id');
                    const action = this.querySelector('i').className;
                    
                    if (action.includes('fa-eye')) {
                        // Quick view
                        openQuickView(productId);
                    } else if (action.includes('fa-exchange-alt')) {
                        showNotification('Tính năng so sánh đang được phát triển!', 'info');
                    } else if (action.includes('fa-share-alt')) {
                        shareProduct(productId);
                    }
                });
            });
            
            function openQuickView(productId) {
                // Hiển thị loading
                showNotification('Đang tải thông tin sản phẩm...', 'info');
                
                // Gọi API để lấy thông tin chi tiết sản phẩm
                fetch(`/product/${productId}/quickview`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showQuickViewModal(data.product);
                        } else {
                            showNotification('Không thể tải thông tin sản phẩm!', 'danger');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Có lỗi xảy ra!', 'danger');
                    });
            }
            
            function showQuickViewModal(product) {
                // Tạo modal quick view
                const modalHtml = `
                    <div class="modal fade" id="quickViewModal" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">${product.productName}</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <img src="${product.images[0]}" class="img-fluid" alt="${product.productName}">
                                        </div>
                                        <div class="col-md-6">
                                            <h4>${product.productName}</h4>
                                            <p class="text-muted">${product.description}</p>
                                            <div class="price mb-3">
                                                <span class="h4 text-primary">${formatPrice(product.price)}₫</span>
                                                ${product.originalPrice ? `<span class="text-muted text-decoration-line-through ms-2">${formatPrice(product.originalPrice)}₫</span>` : ''}
                                            </div>
                                            <div class="mb-3">
                                                <span class="badge bg-${product.inStock ? 'success' : 'danger'}">
                                                    ${product.inStock ? 'Còn hàng' : 'Hết hàng'}
                                                </span>
                                            </div>
                                            <button class="btn btn-primary btn-lg w-100">Thêm vào giỏ hàng</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                
                // Thêm modal vào DOM và hiển thị
                document.body.insertAdjacentHTML('beforeend', modalHtml);
                const modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
                modal.show();
                
                // Xóa modal khi đóng
                document.getElementById('quickViewModal').addEventListener('hidden.bs.modal', function () {
                    this.remove();
                });
            }
            
            function shareProduct(productId) {
                if (navigator.share) {
                    navigator.share({
                        title: 'Xem sản phẩm này tại AMADO',
                        text: 'Khám phá sản phẩm tuyệt vời này!',
                        url: `${window.location.origin}/product/${productId}`
                    })
                    .then(() => showNotification('Chia sẻ thành công!', 'success'))
                    .catch(error => console.log('Lỗi chia sẻ:', error));
                } else {
                    // Fallback cho trình duyệt không hỗ trợ Web Share API
                    navigator.clipboard.writeText(`${window.location.origin}/product/${productId}`)
                        .then(() => showNotification('Đã sao chép link sản phẩm!', 'success'))
                        .catch(err => showNotification('Không thể sao chép link!', 'danger'));
                }
            }
            
             // Filter functionality - CẬP NHẬT PHẦN NÀY
        const applyFiltersBtn = document.getElementById('apply-filters');
        const resetFiltersBtn = document.getElementById('reset-filters');
            
            if (applyFiltersBtn) {
            applyFiltersBtn.addEventListener('click', function() {
                applyFilters();
            });
        }

        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', function() {
                resetFilters();
            });
        }

        function applyFilters() {
            // Collect filter values từ form
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/product/filter'; // Sử dụng route POST hiện có của bạn

            // Lấy danh mục được chọn - CHỈ LẤY 1 CATEGORY (theo logic hiện tại của bạn)
            const categoryCheckboxes = document.querySelectorAll('.category-filter:checked');
            if (categoryCheckboxes.length > 0) {
                // Chỉ lấy category đầu tiên được chọn (theo logic hiện tại của bạn)
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selection';
                input.value = categoryCheckboxes[0].getAttribute('data-category');
                form.appendChild(input);
            }

            // Lấy brand được chọn - CHỈ LẤY 1 BRAND (theo logic hiện tại của bạn)
            const brandCheckboxes = document.querySelectorAll('.brand-filter:checked');
            if (brandCheckboxes.length > 0) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'supplier';
                input.value = brandCheckboxes[0].getAttribute('data-brand');
                form.appendChild(input);
            }

            // Lấy khoảng giá - THÊM TÍNH NĂNG MỚI
            const minPrice = document.getElementById('min-price').value;
            const maxPrice = document.getElementById('max-price').value;
            if (minPrice) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'minPrice';
                input.value = minPrice;
                form.appendChild(input);
            }
            if (maxPrice) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'maxPrice';
                input.value = maxPrice;
                form.appendChild(input);
            }

            // Lấy rating - THÊM TÍNH NĂNG MỚI
            const ratingFilter = document.querySelector('.rating-filter:checked');
            if (ratingFilter) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'rating';
                input.value = ratingFilter.value;
                form.appendChild(input);
            }

            // Lấy availability - THÊM TÍNH NĂNG MỚI
            const inStock = document.getElementById('in-stock').checked;
            const outOfStock = document.getElementById('out-of-stock').checked;
            if (inStock && !outOfStock) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'availability';
                input.value = 'in-stock';
                form.appendChild(input);
            } else if (outOfStock && !inStock) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'availability';
                input.value = 'out-of-stock';
                form.appendChild(input);
            }

            // Submit form sau khi thu thập filter
            document.body.appendChild(form);
            form.submit();
        }

    // Sort functionality - CẬP NHẬT PHẦN NÀY
const sortSelect = document.querySelector('.sort-select');
if (sortSelect) {
    // Khôi phục sort option từ session/selected
    if (serverData.selected || serverData.supplierFilter) {
        // Nếu đang filter, mặc định sort là 'default'
        sortSelect.value = 'default';
    } else {
        // Có thể thêm logic khôi phục sort từ session nếu cần
    }
    
    sortSelect.addEventListener('change', function() {
        const sortValue = this.value;
        
        // Tạo form để submit POST request
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/product/filter';
        
        // Thêm các filter hiện tại
        if (serverData.selected) {
            const selectionInput = document.createElement('input');
            selectionInput.type = 'hidden';
            selectionInput.name = 'selection';
            selectionInput.value = serverData.selected;
            form.appendChild(selectionInput);
        }

        if (serverData.supplierFilter) {
            const supplierInput = document.createElement('input');
            supplierInput.type = 'hidden';
            supplierInput.name = 'supplier';
            supplierInput.value = serverData.supplierFilter;
            form.appendChild(supplierInput);
        }

        // Thêm sort value
        const sortInput = document.createElement('input');
        sortInput.type = 'hidden';
        sortInput.name = 'sort';
        sortInput.value = sortValue;
        form.appendChild(sortInput);
        
        showNotification(`Đang sắp xếp theo: ${this.options[this.selectedIndex].text}`, 'info');
        
        // Submit form
        document.body.appendChild(form);
        form.submit();
    });
}

        function resetFilters() {
            // Reset all filters
            document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                checkbox.checked = false;
            });

            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.checked = false;
            });

            document.getElementById('min-price').value = '';
            document.getElementById('max-price').value = '';

            // Reset sort to default
            const sortSelect = document.querySelector('.sort-select');
            if (sortSelect) {
                sortSelect.value = 'default';
            }
        }

        // Khôi phục trạng thái filter từ session
        function restoreFilterState() {
            // Lấy selected category từ server
            if (serverData.selected) {
                const categoryCheckbox = document.querySelector(`.category-filter[data-category="${serverData.selected}"]`);
                if (categoryCheckbox) {
                    categoryCheckbox.checked = true;
                }
            }

            // Lấy selected brand từ server  
            if (serverData.supplierFilter) {
                const brandCheckbox = document.querySelector(`.brand-filter[data-brand="${serverData.supplierFilter}"]`);
                if (brandCheckbox) {
                    brandCheckbox.checked = true;
                }
            }
            // Lấy selected brand từ server  
            if (serverData.supplierFilter) {
                const brandCheckbox = document.querySelector(`.brand-filter[data-brand="${serverData.supplierFilter}"]`);
                if (brandCheckbox) {
                    brandCheckbox.checked = true;
                }
            }

            // Update price displays
            updatePriceDisplays();
        }

        // Price range slider với real-time update
        const priceSlider = document.getElementById('price-range');
        const minPriceInput = document.getElementById('min-price');
        const maxPriceInput = document.getElementById('max-price');
        const minPriceDisplay = document.querySelector('.price-range small:first-child');
        const maxPriceDisplay = document.querySelector('.price-range small:last-child');

        if (priceSlider && minPriceInput && maxPriceInput) {
            // Update displays
            updatePriceDisplays();

            priceSlider.addEventListener('input', function() {
                const value = this.value;
                minPriceInput.value = 0;
                maxPriceInput.value = value;
                updatePriceDisplays();
            });

            minPriceInput.addEventListener('input', function() {
                const minValue = parseInt(this.value) || 0;
                const maxValue = parseInt(maxPriceInput.value) || 10000000;
                if (minValue > maxValue) {
                    maxPriceInput.value = minValue;
                }
                priceSlider.value = Math.max(minValue, maxValue);
                updatePriceDisplays();
            });

            maxPriceInput.addEventListener('input', function() {
                const maxValue = parseInt(this.value) || 10000000;
                const minValue = parseInt(minPriceInput.value) || 0;
                if (maxValue < minValue) {
                    minPriceInput.value = maxValue;
                }
                priceSlider.value = maxValue;
                updatePriceDisplays();
            });
        }

        function updatePriceDisplays() {
            if (minPriceDisplay && maxPriceDisplay) {
                const minValue = parseInt(minPriceInput.value) || 0;
                const maxValue = parseInt(maxPriceInput.value) || 10000000;

                minPriceDisplay.textContent = formatPrice(minValue) + '₫';
                maxPriceDisplay.textContent = formatPrice(maxValue) + '₫';
            }
        }

        function formatPrice(price) {
            return new Intl.NumberFormat('vi-VN').format(price);
        }
        // Gọi hàm khôi phục khi trang load
        restoreFilterState();
            
            // Auto-apply filters khi thay đổi (tuỳ chọn)
            const filterInputs = document.querySelectorAll('.category-filter, .brand-filter, .rating-filter, .availability-filter');
            filterInputs.forEach(input => {
                input.addEventListener('change', function() {
                    // Có thể bật auto-apply ở đây nếu muốn
                    // applyFilters();
                });
            });
            
            // Newsletter form submission
            const newsletterForm = document.querySelector('.newsletter-form');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const emailInput = this.querySelector('.newsletter-input');
                    const submitButton = this.querySelector('.newsletter-btn');
                    
                    if (emailInput.value) {
                        submitButton.innerHTML = '<span class="loading-spinner"></span>';
                        submitButton.disabled = true;
                        
                        // Simulate API call
                        setTimeout(() => {
                            showNotification('Cảm ơn bạn đã đăng ký nhận tin!', 'success');
                            emailInput.value = '';
                            submitButton.innerHTML = 'Đăng Ký';
                            submitButton.disabled = false;
                        }, 1500);
                    }
                });
            }
            
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Lazy loading cho images
            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            img.src = img.dataset.src;
                            img.classList.remove('lazy');
                            imageObserver.unobserve(img);
                        }
                    });
                });
                
                document.querySelectorAll('img[data-src]').forEach(img => {
                    imageObserver.observe(img);
                });
            }
        });
        
        function showNotification(message, type) {
            // Remove existing notifications
            const existingNotifications = document.querySelectorAll('.custom-notification');
            existingNotifications.forEach(notification => {
                notification.remove();
            });
            
            const notification = document.createElement('div');
            notification.className = `custom-notification alert alert-${type} alert-dismissible fade show`;
            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-circle' : 'info-circle'} me-2"></i>
                    <div>${message}</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(notification);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 5000);
        }
    </script>
</body>
</html>