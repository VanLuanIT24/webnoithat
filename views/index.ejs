        <!-- Nút Yêu thích -->
        <% 
        let isFavorite = false;
        if (customer.listFavorite && customer.listFavorite.length > 0) {
            isFavorite = customer.listFavorite.some(fav => fav._id.toString() === product._id.toString());
        }
        %>
        
        <% if (isFavorite) { %>
            <a href="/product/favorite/delete/<%= product._id %>" class="btn btn-favorite active" title="Xóa khỏi yêu thích">
