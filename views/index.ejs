    <% } else { %>
        <% if (product.description.stock > 0) { %>
            <a href="/login" class="btn btn-add-to-cart" title="Đăng nhập để thêm vào giỏ hàng">
                <i class="fas fa-cart-plus"></i>
            </a>
        <% } else { %>
            <button class="btn btn-add-to-cart" disabled title="Hết hàng">
                <i class="fas fa-cart-plus"></i>
            </button>
        <% } %>
        <a href="/login" class="btn btn-favorite" title="Đăng nhập để thêm vào yêu thích">
